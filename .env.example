# Local demo credentials only. Choose different values before exposing services.
MYSQL_ROOT_PASSWORD=incidentlens-root-local
DB_USER=incidentlens
DB_PASSWORD=incidentlens-local
GRAFANA_ADMIN_PASSWORD=incidentlens-local
# Host ports bind only to 127.0.0.1. Container ports stay 8080/8081/8082.
CONTROL_PLANE_PORT=8080
DEMO_API_PORT=8081
DEMO_WORKER_PORT=8082
WEB_PORT=3000
GRAFANA_PORT=3001
PROMETHEUS_PORT=9090
# Default rule-based RCA requires no API key.
RCA_BASE_URL=https://api.openai.com/v1
RCA_API_KEY=
RCA_MODEL=
# dev-up -Observability sets this false automatically for that invocation.
OTEL_SDK_DISABLED=true
